{
  "source_revision": "260b2aaea325fb338e20bc6a25e7a9bedbacf761",
  "governorCreationBlockLowerBound": 5,
  "evidence_kind": "Lower bound from the original public deployment protocol, not a recovered creation receipt.",
  "proof": [
    "The chain starter enables automining before the voting setup starts.",
    "The setup broadcasts Token and Protocol creations in two successive completed forge create commands.",
    "The deployment script then broadcasts VoteToken, TimelockController, and TokenGovernor creations, in that order.",
    "The script uses --slow. Foundry 1.5.1 waits for each transaction to succeed before sending the next.",
    "Each confirmed transaction therefore precedes the next transaction's block. The fifth creation cannot occur before block 5."
  ],
  "limitations": [
    "The exact historical creation block, transaction hash, and block hash are unavailable.",
    "This inference relies on the checked trial having used its locked task and pinned chain image."
  ],
